# Backend API origin, WITHOUT the /api/v1 prefix (lib/api/client.ts adds it).
# Must be same-site with this app's origin so the SameSite=Strict refresh
# cookie is sent (localhost:3001 ↔ localhost:3000 is fine in dev).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Port this app runs on (npm run dev / npm start, and the host port in
# docker compose). Keep the backend's APP_BASE_URL on the same port — emailed
# invite and reset links are built from it.
WEB_PORT=3001
