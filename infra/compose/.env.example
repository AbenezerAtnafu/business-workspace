# Copy to .env and fill in. Every secret below MUST be changed for anything
# other than a throwaway laptop stack (generate with: openssl rand -base64 32).

# --- Hostnames -------------------------------------------------------------
# The platform's mail hostname: MX target, SMTP/IMAP server name, autodiscovery
# target, HELO name. Needs an A record and a matching PTR (reverse DNS).
MAIL_HOSTNAME=mail.localhost
APP_BASE_URL=http://localhost:3001          # where people open the web app (invite/reset links)
PUBLIC_API_URL=http://localhost:3000        # API origin as the BROWSER reaches it (baked into the web build)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                         # true behind HTTPS
# Reverse proxy in front of the API (TLS on :443)? Tell the API how many hops
# to trust X-Forwarded-For from, or every client shares the proxy's address
# for per-IP rate limits. Leave empty when nothing sits in front.
TRUST_PROXY=
APP_MAIL_FROM=Business Workspace <no-reply@mail.localhost>

# --- Database roles (migrations 006, 008, 015 create them with dev passwords;
#     on a real server run ALTER ROLE ... PASSWORD to match these) ----------
POSTGRES_PASSWORD=postgres
APP_USER_PASSWORD=app_user_dev_password
APP_BOOTSTRAP_PASSWORD=app_bootstrap_dev_password
MAIL_READER_PASSWORD=mail_reader_dev_password
DKIM_EXPORTER_PASSWORD=dkim_exporter_dev_password

# --- App secrets -------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ENCRYPTION_KEY=change-me-encryption        # encrypts MFA secrets + DKIM keys; never change once data exists
DOVECOT_MASTER_PASSWORD=change-me-dovecot-master

# --- Mail ---------------------------------------------------------------------
INTERNAL_SUBNET=172.28.0.0/16
# Development: Mailpit catches all outbound mail (UI on :8025).
RELAY_HOST=[mailpit]:1025
RELAY_TLS_LEVEL=none
# Production (bootstrap period, ADR-002), e.g. Amazon SES:
# RELAY_HOST=[email-smtp.eu-west-1.amazonaws.com]:587
# RELAY_USER=...
# RELAY_PASSWORD=...
# RELAY_TLS_LEVEL=encrypt
# CLAMAV_MILTER=inet:clamav:7357           # with: docker compose --profile av up -d
MILTER_DEFAULT_ACTION=tempfail

# API, web and Mailpit listen on this address only (127.0.0.1 = reachable from
# the host itself: the reverse proxy, or SSH port forwarding). Mail ports are
# always public.
HTTP_BIND_ADDR=127.0.0.1

# --- Published ports (change if something on the host already uses them) -------
API_PORT=3000
WEB_PORT=3001
SMTP_PORT=25          # use e.g. 2525 on a laptop
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP3S_PORT=995
MAILPIT_UI_PORT=8025
