# Env vars grouped by the phase that first needs them (planning/implementation-plan.md).
# Everything under "Phase 1" has to be real before Step 1.4 (Auth) can run end to end;
# the rest are placeholders so the shape is documented ahead of time — fill them in
# when you actually reach that phase, don't stub them with fake values now.

NODE_ENV=development
PORT=3000

# --- Phase 1 — Foundation ---------------------------------------------------

# Single Postgres instance holding both the control and tenant schemas (see
# architecture/data-model.md — "Implementation note on two databases").
# Superuser — used ONLY by scripts/run-migrate.js. Never point the app's own
# runtime connection (APP_DATABASE_URL below) at this role: see
# src/database/migrations/006_app_runtime_role.sql for why — superusers
# bypass every RLS policy unconditionally, which would silently defeat the
# tenant isolation migrations 004+ set up.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/business_workspace

# The app's actual runtime connection pool (DatabaseService) — a dedicated,
# non-superuser, non-BYPASSRLS role (created by migration 006) so RLS is
# actually enforced rather than just assumed. Required; the app refuses to
# start without it rather than silently falling back to DATABASE_URL.
APP_DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5432/business_workspace

# A THIRD role, distinct from both of the above — read-only, BYPASSRLS
# (created by migration 008), used ONLY by the handful of lookups that
# deliberately query a tenant.* table before the organization is known
# (refresh-token lookup, MFA challenge lookup, invite-token preview). See
# migrations/008_app_bootstrap_role.sql for the full story: these lookups
# are safe across every org because the lookup key is an unguessable
# secret, but ordinary RLS can't serve them (the org context literally
# isn't known yet), and a subtle Postgres quirk around how a "SET LOCAL"-
# style session variable rests after commit turns that into a 500, not
# just an empty result, if routed through the ordinary RLS-scoped role.
APP_BOOTSTRAP_DATABASE_URL=postgres://app_bootstrap:app_bootstrap_dev_password@localhost:5432/business_workspace

# Access token (short-lived, sent as a Bearer header) vs. refresh token
# (httpOnly/Secure/SameSite cookie) — architecture/api-contract.md §0 conventions.
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_TTL=30d

# Refresh-token cookie attributes (architecture/api-contract.md §0: httpOnly,
# Secure, SameSite). COOKIE_SECURE should be true everywhere except plain-http
# local dev.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# App-layer envelope-encryption key for columns marked "encrypted at rest" in
# architecture/data-model.md: tenant.users.mfa_secret (Step 1.4) now, and
# control.domains.dkim_private_key (Step 2.2) once you get there. Generate
# once per environment, e.g. `openssl rand -base64 32` — never reuse the
# `change-me` placeholder past local dev.
ENCRYPTION_KEY=change-me

# Outbound relay used during the sender-reputation bootstrap period (ADR-002)
# and, per Step 1.4, to carry invite/password-reset links before the
# self-hosted mail stack (Step 2.1) is live. Leave SMTP_RELAY_HOST empty in
# local dev and MailerService logs the email instead of sending it — there's
# no real relay to point at in this sandbox, and that's the only way to
# verify the password-reset flow end to end without one.
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=
SMTP_RELAY_FROM="Business Workspace Platform <no-reply@example.com>"

# The frontend's own public origin — needed here only to build links that
# get emailed out (password reset) rather than returned in an API response.
APP_BASE_URL=http://localhost:3001

# --- Phase 2 — Domains & Email core (fill in when you reach Step 2.x) ------

# S3-compatible object storage for tenant.attachment_uploads staging only
# (claude/srs.md §7.7 — not a general file store). Needed from Step 2.4.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# Mail infrastructure connection details (Dovecot SQL auth driver, Postfix
# milter sockets, etc. — architecture/domain-and-email-flow.md). These are
# mostly consumed by the mail stack's own config, not this app directly;
# add here only what the NestJS app itself needs to talk to it (Step 2.1+).
# DOVECOT_AUTH_SOCKET=

# --- Phase 3 — Workspace features (fill in when you reach Step 3.x) -------

# Only needed if/when Notifications (Step 3.1) or a background job queue
# ends up requiring them — SRS §9 lists these as the suggested stack, not a
# Phase 1 requirement.
# REDIS_URL=
# RABBITMQ_URL=

# --- Volume quotas (ADR-011) ------------------------------------------------
# Per one-hour window; the values shown are the defaults used when unset.
# Every attempt counts (not just failures). Over the limit → 429 RATE_LIMITED
# with Retry-After. All requests from your own machine share one IP, so if
# you sign up lots of test organizations locally, raise the first one.
# RATE_LIMIT_SIGNUPS_PER_IP_PER_HOUR=10
# RATE_LIMIT_INVITES_PER_ORG_PER_HOUR=50
# RATE_LIMIT_REISSUES_PER_USER_PER_HOUR=5
# RATE_LIMIT_REISSUES_PER_ORG_PER_HOUR=30
# RATE_LIMIT_RESET_REQUESTS_PER_EMAIL_PER_HOUR=3
# RATE_LIMIT_RESET_REQUESTS_PER_IP_PER_HOUR=20
