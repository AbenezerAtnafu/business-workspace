{
  "name": "business-workspace-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Business Workspace Platform — backend API (NestJS). See planning/implementation-plan.md (project docs) for build order.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
