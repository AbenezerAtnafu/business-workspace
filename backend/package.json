    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate": "node scripts/run-migrate.js",
    "test:live": "node scripts/live-test.mjs",
    "test:mail": "node scripts/mail-live-test.mjs",
    "test:webmail": "node scripts/webmail-live-test.mjs",
    "dkim:export": "node scripts/export-dkim-keys.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "imapflow": "^2.2.7",
    "mailparser": "^3.9.36",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.15",
